---
/**
 * Noticia.astro — La estructura de un artículo.
 * Sólo el marco: portada, título, cuerpo legible y notas relacionadas.
 */
import Base from './Base.astro';
import PortadaNoticia from '../components/PortadaNoticia.astro';
import { CATEGORIA_COLOR, noticia, otras } from '../lib/noticias';
import { fecha } from '../lib/formato';

interface Props { slug: string }
const { slug } = Astro.props;
const n = noticia(slug);
const color = CATEGORIA_COLOR[n.categoria];
const relacionadas = otras(slug, 3);
---

<Base titulo={n.titulo} descripcion={n.bajada}>
  <article>
    <header class="cabeza">
      <div class="contenedor estrecho">
        <p class="miga">
          <a href="/noticias/">Noticias fiscales</a>
          <span class="sep">·</span>
          <span class="cat" style={`color:${color}`}>{n.categoria}</span>
        </p>
        <h1 class="display titulo">{n.titulo}</h1>
        <p class="bajada">{n.bajada}</p>
        <p class="meta mini">
          {fecha(n.fecha)} · {n.minutos} minutos de lectura
        </p>
      </div>
    </header>

    <div class="contenedor estrecho">
      <div class="portada-nota">
        <PortadaNoticia variante={n.portada} cifra={n.cifra} pie={n.cifraPie}
                        categoria={n.categoria} color={color} alto={230} />
      </div>

      <div class="cuerpo"><slot /></div>

      <aside class="relacionadas">
        <h2 class="display h-rel">Seguí leyendo</h2>
        <ul>
          {relacionadas.map((r) => (
            <li>
              <a href={`/noticias/${r.slug}/`}>
                <span class="r-cat" style={`color:${CATEGORIA_COLOR[r.categoria]}`}>{r.categoria}</span>
                <span class="r-tit">{r.titulo}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </article>
</Base>

<style>
  .cabeza { background: var(--navy); color: #fff; padding-block: 44px 40px; }
  .miga { font-size: .82rem; color: #8FA2BE; margin-bottom: 12px; }
  .miga a { color: var(--oro-claro); }
  .miga .sep { margin-inline: 8px; }
  .miga .cat { font-weight: 700; filter: brightness(1.7); }
  .titulo { font-size: clamp(1.9rem, 4.6vw, 2.9rem); margin-bottom: 14px; }
  .cabeza .bajada { color: #CBD8EA; font-size: 1.08rem; }
  .meta { color: #8FA2BE; margin-top: 14px; }

  .portada-nota { margin-top: -22px; border-radius: var(--r-lg); overflow: hidden;
                  box-shadow: var(--sombra-lg); }

  .cuerpo { margin-top: 34px; font-size: 1.06rem; line-height: 1.78; }
  .cuerpo :global(p) { margin-bottom: 20px; }
  .cuerpo :global(h2) {
    font-family: 'Barlow Condensed', sans-serif; font-weight: 800;
    font-size: clamp(1.4rem, 3vw, 1.85rem); color: var(--navy);
    margin: 36px 0 14px;
  }
  .cuerpo :global(strong) { color: var(--navy); font-weight: 600; }
  .cuerpo :global(.destacado) {
    font-family: 'Barlow Condensed', sans-serif; font-weight: 800;
    font-size: clamp(1.5rem, 3.4vw, 2rem); line-height: 1.25;
    color: var(--navy); border-left: 4px solid var(--oro);
    padding: 6px 0 6px 20px; margin: 30px 0;
  }
  .cuerpo :global(ul) { margin: 0 0 20px 20px; }
  .cuerpo :global(li) { margin-bottom: 8px; }

  .relacionadas { margin-top: 46px; border-top: 1px solid var(--borde); padding-top: 26px; }
  .h-rel { font-size: 1.4rem; color: var(--navy); margin-bottom: 14px; }
  .relacionadas ul { list-style: none; display: grid; gap: 10px; }
  .relacionadas a {
    display: block; text-decoration: none;
    background: var(--papel); border: 1px solid var(--borde);
    border-radius: var(--r-md); padding: 15px 18px;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .relacionadas a:hover { transform: translateY(-2px); box-shadow: var(--sombra); }
  .r-cat {
    display: block; font-size: .68rem; font-weight: 700;
    letter-spacing: .09em; text-transform: uppercase; margin-bottom: 4px;
  }
  .r-tit { color: var(--navy); font-weight: 600; line-height: 1.4; }
</style>
