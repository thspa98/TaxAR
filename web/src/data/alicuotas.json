  "iibb-comercio": {
   "etiqueta": "Ingresos Brutos — comercio y servicios",
   "corto": "IIBB comercio",
   "explica": "Se cobra sobre la facturación de cada negocio, en cada etapa de la cadena. No lo pagás vos directamente, pero está incorporado en el precio de casi todo lo que comprás: es el impuesto provincial que más recauda y el que más se nota en el bolsillo sin que se vea.",
   "quien": "Lo paga el comercio y se traslada al precio",
   "base": "sobre la facturación",
   "color": "#1A2B48"
  },
  "iibb-industria": {
   "etiqueta": "Ingresos Brutos — industria y producción primaria",
   "corto": "IIBB industria",
   "explica": "La misma lógica, pero para fábricas y producción agropecuaria. Casi todas las provincias la tienen mucho más baja —a veces en cero— para no encarecer lo que se produce dentro de su territorio.",
   "quien": "Lo paga la industria radicada en la provincia",
   "base": "sobre la facturación",
   "color": "#2D4A7A"
  },
  "sellos-contratos": {
