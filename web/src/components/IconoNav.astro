---
/**
 * IconoNav.astro — Los íconos del menú.
 *
 * Dibujados a mano en SVG de 24×24 con trazo, no importados de ninguna
 * librería: nueve íconos pesan menos de 2 KB en total y se colorean solos con
 * `currentColor`, así que siguen al texto en cada estado del enlace.
 *
 * Cada uno alude a lo que hace la sección, no al tema en abstracto: el de
 * coparticipación es una flecha que se bifurca, el de dependencia son dos
 * eslabones, el de metodología una lupa sobre una hoja.
 */
interface Props { nombre: string }
const { nombre } = Astro.props;

const D: Record<string, string> = {
  // casa
  inicio: 'M3 10.5 12 3l9 7.5M5.5 9.5V20h13V9.5M9.5 20v-6h5v6',
  // pin en el mapa
  provincia: 'M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  // barras de distinta altura
  gasto: 'M4 20V11M10 20V5M16 20v-7M22 20H2',
  // porción de torta
  destino: 'M12 3a9 9 0 1 0 9 9h-9V3Z M14.5 3.6A9 9 0 0 1 20.4 9.5',
  // ticket con un porcentaje
  impuestos: 'M6 3h12v18l-3-2-3 2-3-2-3 2V3Z M9.5 9.5h.01M14.5 14.5h.01M15 9l-6 6',
  // una flecha que se parte en dos
  coparticipacion: 'M12 3v7M12 10 6.5 15M12 10l5.5 5M4 21h5M15 21h5',
  // dos eslabones
  dependencia: 'M10.5 13.5a4 4 0 0 0 5.7 0l2.8-2.8a4 4 0 0 0-5.7-5.7l-1.6 1.6 M13.5 10.5a4 4 0 0 0-5.7 0l-2.8 2.8a4 4 0 0 0 5.7 5.7l1.6-1.6',
  // diario doblado
  noticias: 'M4 5h13v14H4V5Z M17 9h3v8a2 2 0 0 1-3 1.7 M7 8.5h7M7 12h7M7 15.5h4',
  // lupa sobre una hoja
  metodologia: 'M6 3h9l4 4v14H6V3Z M14 3v4h4 M11 11.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z M13 15.5 15.5 18',
};

const d = D[nombre] ?? D.inicio;
---

<svg
  class="ico"
  viewBox="0 0 24 24"
  width="21"
  height="21"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {d.split(' M').map((tramo, i) => <path d={(i ? 'M' : '') + tramo} />)}
</svg>

<style>
  .ico {
    flex: none;
    transition: transform .22s cubic-bezier(.22, .8, .3, 1);
  }
</style>
